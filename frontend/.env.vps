# VPS 部署构建专用（npm run build:vps → vite build --mode vps）
#
# 与本地开发/默认构建的区别：
#   .env            → VITE_USE_MOCK=true   纯前端 mock，离线可演示，不需要后端
#   .env.vps（本文件）→ VITE_USE_MOCK=false 走真实 FastAPI 后端（同源相对路径）
#
# 接口地址无需配置：前端 axios baseURL 为 '/'，请求 /api/* 与 /data/layers/*，
# 与后端同端口（单端口全栈部署），因此不存在跨域问题。

VITE_USE_MOCK=false

# ---- 天地图 Key（可选）----
# 留空则自动回退 OSM 底图。若填 Key，需重新执行 npm run build:vps 才会生效。
VITE_TIANDITU_KEY=
