# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/

# ---- Node ----
node_modules/
dist/
build/
.vite/
*.local

# ---- 数据 ----
# 原始数据一律不入库（体积大、含敏感测绘成果）
data/raw/*
!data/raw/.gitkeep

# 其他二进制 / 遥感 / 压缩格式不入库
*.shp
*.shx
*.dbf
*.prj
*.cpg
*.sbn
*.sbx
*.gdb/
*.tif
*.tiff
*.img
*.zip
*.rar
*.7z
*.gpkg
*.mbtiles

# ---- 处理后空间数据入库（2026-09-10 起：交付与前端部署需要）----
# 由 scripts/preprocess.py 生成，图层清单见 data/processed/layers_manifest.json
# 注意：以下否定规则必须位于上面的扩展名黑名单之后，否则不生效
!data/processed/
!data/processed/**
!frontend/public/data/
!frontend/public/data/**

# ---- 数据库 ----
*.sqlite
*.sqlite3
*.db
*.db-shm
*.db-wal

# ---- 密钥与环境 ----
.env
.env.*
!.env.example
*.key
*.pem
**/secrets.*

# ---- 编辑器/系统 ----
.idea/
.vscode/
.workbuddy/
.DS_Store
Thumbs.db
*.swp

# ---- 日志 ----
logs/
*.log

# ---- 脚本临时产物 ----
.gh_resp.json
.req*.json
sel.json
api?.json
tree.json
dist/
