# 复制为 backend/.env 后填写。.env 本身不进 Git。

# ---- 服务 ----
# 本机开发保持 127.0.0.1；部署到 VPS 必须改 0.0.0.0 才能被公网访问。
# 端口须落在 VPS 已放行的区间内（当前部署用 8080）。
API_HOST=127.0.0.1
API_PORT=8000

# ---- 大模型增强（DeepSeek，可选）----
# 铁律：关闭或 Key 无效时，系统仍以「规则解析」跑通全流程，不影响演示。
# 四项填全后**重启后端**即生效，无需重新构建前端。
# 申请 Key：https://platform.deepseek.com/api_keys
LLM_ENABLED=false
# LLM_BASE_URL=https://api.deepseek.com
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# LLM_MODEL=deepseek-chat
#
# ⚠️ 四项缺一不可：后端判定「可用」要求四者全部非空（见 app/services/llm.py
#    的 llm_available()）。只填 Key 而漏填 BASE_URL / MODEL 会**静默走规则版**，
#    界面无任何异常提示，容易误以为已接入。
#
# 模型选择（均已实测）：
#   deepseek-chat   对话模型，解析约 2s，输出仅十余 token，最省最快
#   deepseek-flash  推理模型，解析约 2~5s，会先生成一段不返回给用户的思考内容
#                   该思考同样占用 max_tokens，故输出预算须放宽——相关默认值
#                   见 app/config.py 的 LLM_MAX_TOKENS_PARSE / CHAT（2048/2048）。
#                   预算不足会表现为「大模型返回内容为空」并回退规则版。
#
# 可选：覆盖输出预算与超时（一般无需设置，默认值已适配推理模型）
# LLM_MAX_TOKENS_PARSE=2048
# LLM_MAX_TOKENS_CHAT=2048
# LLM_TIMEOUT_S=60
#
# 兼容任意 OpenAI 协议服务，替换 BASE_URL 与 MODEL 即可，例如：
#   通义千问  LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen-plus
#   智谱 GLM  LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4            LLM_MODEL=glm-4-plus

# ---- 选址引擎默认参数 ----
DEFAULT_GRID_SIZE_M=30
DEFAULT_MIN_AREA_HA=1.0
DEFAULT_TOP_N=5
